.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
build/
coverage/
# 这两个由 flutter pub get / 构建生成，内容随本机依赖版本漂移，
# 提交它们只会制造无意义的 diff（应用本身也不用锁依赖版本）。
pubspec.lock
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
android/.gradle/
android/local.properties
android/key.properties
# 发布密钥本体一律不进仓库。真机上它放在仓库之外（见 README 的发布说明），
# 这里再兜一道，避免哪天手滑 cp 进来。
*.jks
*.keystore
android/app/debug/
android/app/profile/
android/app/release/
android/app/src/main/jniLibs/
rust/target/

# Flutter 注入的 Gradle Wrapper（见 README，不纳入版本管理）
android/gradlew
android/gradlew.bat
android/gradle/wrapper/
